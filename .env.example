# ==========================================
# CONFIGURACIÓN DEL SERVIDOR FLASK
# ==========================================
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# ==========================================
# CONFIGURACIÓN DE MYSQL (SQLAlchemy)
# ==========================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=tu_contraseña
MYSQL_DB=sena_db

# URI de conexión directa para SQLAlchemy:
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:tu_contraseña@127.0.0.1:3307/sena_db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ==========================================
# CONFIGURACIÓN DE MONGODB
# ==========================================
MONGO_URI=mongodb://127.0.0.1:27017/sena_mongodb
